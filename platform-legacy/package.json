{
  "name": "loraloop",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @loraloop/database db:generate",
    "db:migrate": "pnpm --filter @loraloop/database db:migrate",
    "db:migrate:dev": "pnpm --filter @loraloop/database db:migrate:dev",
    "db:studio": "pnpm --filter @loraloop/database db:studio",
    "db:seed": "pnpm --filter @loraloop/database db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
